<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/CouchGameSetup.uss"/>
    <ui:VisualElement name="gameSetup" class="setup-screen is-hidden">
        <ui:VisualElement name="setupCanvas" class="setup-canvas">
            <ui:VisualElement class="setup-shadow setup-practice-panel-shadow" picking-mode="Ignore"/>
            <ui:VisualElement class="setup-practice-panel" picking-mode="Ignore"/>
            <ui:VisualElement class="setup-heading setup-practice-title" picking-mode="Ignore"><ui:Label text="Practice Mode" class="setup-heading-shadow"/><ui:Label text="Practice Mode" class="setup-heading-stroke"/><ui:Label text="Practice Mode" class="setup-heading-fill"/></ui:VisualElement>
            <ui:VisualElement class="setup-shadow setup-preview-shadow" picking-mode="Ignore"/>
            <ui:VisualElement name="setupPracticePreview" class="setup-practice-preview" picking-mode="Ignore"/>
            <ui:Label text="Pick up loose flasks and toss them in the collectors. Throw flasks at other players to stun them. When time runs out, the player with the fewest flasks in their area wins!" class="setup-description" picking-mode="Ignore"/>
            <ui:VisualElement class="setup-settings">
                <ui:VisualElement class="setup-heading setup-settings-title" picking-mode="Ignore"><ui:Label text="Game Settings" class="setup-heading-shadow"/><ui:Label text="Game Settings" class="setup-heading-stroke"/><ui:Label text="Game Settings" class="setup-heading-fill"/></ui:VisualElement>
                <ui:VisualElement class="setup-setting setup-rounds-setting"><ui:Label text="Rounds" class="setup-setting-name"/><ui:VisualElement class="setup-selector"><ui:Button name="previousSetupRounds" class="setup-arrow setup-arrow-previous" tooltip="Previous Rounds"/><ui:Label name="setupRounds" text="3 Rounds" class="setup-setting-value"/><ui:Button name="nextSetupRounds" class="setup-arrow" tooltip="Next Rounds"/></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement class="setup-setting setup-cpu-setting"><ui:Label text="CPU Level" class="setup-setting-name"/><ui:VisualElement class="setup-selector"><ui:Button name="previousSetupCpu" class="setup-arrow setup-arrow-previous" tooltip="Previous CPU Level"/><ui:Label name="setupCpuLevel" text="Normal" class="setup-setting-value"/><ui:Button name="nextSetupCpu" class="setup-arrow" tooltip="Next CPU Level"/></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement class="setup-heading setup-controls-title" picking-mode="Ignore"><ui:Label text="Controls" class="setup-heading-shadow"/><ui:Label text="Controls" class="setup-heading-stroke"/><ui:Label text="Controls" class="setup-heading-fill"/></ui:VisualElement>
                <ui:VisualElement class="setup-control-row setup-move-row" picking-mode="Ignore"><ui:VisualElement class="setup-control-pair"><ui:VisualElement class="setup-icon-cell"><ui:VisualElement class="setup-control-icon setup-stick" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup.png');"/></ui:VisualElement><ui:VisualElement class="setup-slash-wrap" picking-mode="Ignore"><ui:VisualElement class="setup-control-icon setup-slash" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/ControlSlash.png');"/></ui:VisualElement><ui:VisualElement class="setup-icon-cell"><ui:VisualElement class="setup-control-icon setup-keys" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup1.png');"/></ui:VisualElement></ui:VisualElement><ui:Label text="Move" class="setup-control-name"/></ui:VisualElement>
                <ui:VisualElement class="setup-control-row setup-throw-row" picking-mode="Ignore"><ui:VisualElement class="setup-control-pair"><ui:VisualElement class="setup-icon-cell setup-small-cell"><ui:VisualElement class="setup-control-icon setup-b" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup2.png');"/></ui:VisualElement><ui:VisualElement class="setup-slash-wrap" picking-mode="Ignore"><ui:VisualElement class="setup-control-icon setup-slash" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/ControlSlash.png');"/></ui:VisualElement><ui:VisualElement class="setup-icon-cell"><ui:VisualElement class="setup-control-icon setup-mouse" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup3.png');"/></ui:VisualElement></ui:VisualElement><ui:Label text="Throw" class="setup-control-name"/></ui:VisualElement>
                <ui:Label name="setupStatus" class="setup-status is-hidden"/>
                <ui:VisualElement class="setup-shadow setup-start-shadow" picking-mode="Ignore"/>
                <ui:Button name="setupStart" text="Start!" class="setup-start">
                    <ui:VisualElement class="setup-start-content" picking-mode="Ignore"><ui:VisualElement class="setup-start-icons"><ui:VisualElement class="setup-icon-cell"><ui:VisualElement class="setup-control-icon setup-start-icon" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup4.png');"/></ui:VisualElement><ui:VisualElement class="setup-slash-wrap" picking-mode="Ignore"><ui:VisualElement class="setup-control-icon setup-slash" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/StartSlash.png');"/></ui:VisualElement><ui:VisualElement class="setup-icon-cell"><ui:VisualElement class="setup-control-icon setup-enter" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup5.png');"/></ui:VisualElement></ui:VisualElement><ui:Label text="Start!" class="setup-start-text"/></ui:VisualElement>
                </ui:Button>
                <ui:VisualElement class="setup-player-row"><ui:VisualElement class="setup-player-slot"><ui:VisualElement class="setup-shadow setup-mini-shadow" picking-mode="Ignore"/><ui:VisualElement name="setupPlayer1" class="setup-player"><ui:VisualElement class="setup-player-portrait" picking-mode="Ignore"/><ui:VisualElement class="setup-player-caption" picking-mode="Ignore"><ui:Label name="setupReadyShadow1" class="setup-ready setup-ready-shadow"/><ui:Label name="setupReadyStroke1" class="setup-ready setup-ready-stroke"/><ui:Label name="setupReady1" class="setup-ready setup-ready-fill"/></ui:VisualElement></ui:VisualElement></ui:VisualElement>
<ui:VisualElement class="setup-player-slot"><ui:VisualElement class="setup-shadow setup-mini-shadow" picking-mode="Ignore"/><ui:VisualElement name="setupPlayer2" class="setup-player"><ui:VisualElement class="setup-player-portrait" picking-mode="Ignore"/><ui:VisualElement class="setup-player-caption" picking-mode="Ignore"><ui:Label name="setupReadyShadow2" class="setup-ready setup-ready-shadow"/><ui:Label name="setupReadyStroke2" class="setup-ready setup-ready-stroke"/><ui:Label name="setupReady2" class="setup-ready setup-ready-fill"/></ui:VisualElement></ui:VisualElement></ui:VisualElement>
<ui:VisualElement class="setup-player-slot"><ui:VisualElement class="setup-shadow setup-mini-shadow" picking-mode="Ignore"/><ui:VisualElement name="setupPlayer3" class="setup-player"><ui:VisualElement class="setup-player-portrait" picking-mode="Ignore"/><ui:VisualElement class="setup-player-caption" picking-mode="Ignore"><ui:Label name="setupReadyShadow3" class="setup-ready setup-ready-shadow"/><ui:Label name="setupReadyStroke3" class="setup-ready setup-ready-stroke"/><ui:Label name="setupReady3" class="setup-ready setup-ready-fill"/></ui:VisualElement></ui:VisualElement></ui:VisualElement>
<ui:VisualElement class="setup-player-slot"><ui:VisualElement class="setup-shadow setup-mini-shadow" picking-mode="Ignore"/><ui:VisualElement name="setupPlayer4" class="setup-player"><ui:VisualElement class="setup-player-portrait" picking-mode="Ignore"/><ui:VisualElement class="setup-player-caption" picking-mode="Ignore"><ui:Label name="setupReadyShadow4" class="setup-ready setup-ready-shadow"/><ui:Label name="setupReadyStroke4" class="setup-ready setup-ready-stroke"/><ui:Label name="setupReady4" class="setup-ready setup-ready-fill"/></ui:VisualElement></ui:VisualElement></ui:VisualElement>
</ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="setup-footer">
                <ui:Button name="setupBack" text="Back" class="setup-back"><ui:VisualElement class="setup-back-content" picking-mode="Ignore"><ui:VisualElement class="setup-small-cell"><ui:VisualElement class="setup-control-icon setup-back-icon" picking-mode="Ignore" style="background-image: url('project://database/Assets/UI/Setup/imgGroup6.png');"/></ui:VisualElement><ui:Label text="Back" class="setup-back-text"/></ui:VisualElement></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

