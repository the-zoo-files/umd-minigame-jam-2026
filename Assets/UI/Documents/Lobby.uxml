<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/CouchConnectionMenu.uss?fileID=7433441132597879392&amp;guid=7b6296f5bce329344bf8554be994d811&amp;type=3#CouchConnectionMenu"/>
    <ui:VisualElement name="connectionMenu" class="connection-menu">
        <ui:VisualElement class="lobby-header">
            <ui:VisualElement picking-mode="Ignore" class="lobby-title-stack">
                <ui:Label text="Join and select a character." picking-mode="Ignore" class="lobby-title lobby-title-shadow" style="top: -4px; bottom: 5px; right: 0; left: 0;"/>
                <ui:Label text="Join and select a character." picking-mode="Ignore" class="lobby-title lobby-title-stroke" style="-unity-text-outline-color: rgb(235, 86, 40);"/>
                <ui:Label text="Join and select a character." picking-mode="Ignore" class="lobby-title lobby-title-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="lobby-stage">
            <ui:VisualElement class="connection-cards">
                <ui:VisualElement name="connectionPlayer1" class="connection-card card-tilt-left is-empty player-color-0">
                    <ui:VisualElement class="waiting-visual"/>
                    <ui:VisualElement class="player-card-content">
                        <ui:VisualElement class="device-icon keyboard-device">
                            <ui:VisualElement class="device-shadow"/>
                            <ui:VisualElement class="device-outline"/>
                            <ui:VisualElement class="device-fill"/>
                            <ui:VisualElement class="device-stroke"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="device-icon controller-device">
                            <ui:VisualElement class="device-shadow"/>
                            <ui:VisualElement class="device-outline"/>
                            <ui:VisualElement class="device-fill"/>
                            <ui:VisualElement class="device-stroke"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="character-content">
                            <ui:VisualElement class="character-portrait">
                                <ui:VisualElement class="character-image"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="characterSelector1" class="character-selector">
                                <ui:Button name="previousCharacter1" tooltip="Previous character" class="character-arrow arrow-left">
                                    <ui:VisualElement class="icon-shadow"/>
                                    <ui:VisualElement class="icon-outline"/>
                                    <ui:VisualElement class="icon-art"/>
                                </ui:Button>
                                <ui:VisualElement class="character-name-stack">
                                    <ui:Label name="playerCharacterShadow1" text="Testudo" picking-mode="Ignore" class="character-name character-name-shadow"/>
                                    <ui:Label name="playerCharacterStroke1" text="Testudo" picking-mode="Ignore" class="character-name character-name-stroke"/>
                                    <ui:Label name="playerCharacter1" text="Testudo" picking-mode="Ignore" class="character-name character-name-fill"/>
                                </ui:VisualElement>
                                <ui:Button name="nextCharacter1" tooltip="Next character" class="character-arrow arrow-right">
                                    <ui:VisualElement class="icon-shadow"/>
                                    <ui:VisualElement class="icon-outline"/>
                                    <ui:VisualElement class="icon-art"/>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="cardAction1" class="card-action">
                        <ui:VisualElement class="card-prompt-content">
                            <ui:VisualElement name="cardPromptGlyphStack1" class="prompt-glyph-stack input-xbox">
                                <ui:Label name="cardPromptGlyphShadow1" class="prompt-glyph prompt-glyph-shadow"/>
                                <ui:Label name="cardPromptGlyphStroke1" class="prompt-glyph prompt-glyph-stroke"/>
                                <ui:Label name="cardPromptGlyph1" class="prompt-glyph prompt-glyph-fill"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="card-prompt-stack">
                                <ui:Label name="cardPromptSizer1" text="Join" picking-mode="Ignore" class="card-prompt-text card-prompt-sizer"/>
                                <ui:Label name="cardPromptShadow1" text="Join" picking-mode="Ignore" class="card-prompt-text card-prompt-shadow"/>
                                <ui:Label name="cardPromptStroke1" text="Join" picking-mode="Ignore" class="card-prompt-text card-prompt-stroke"/>
                                <ui:Label name="cardPromptText1" text="Join" picking-mode="Ignore" class="card-prompt-text card-prompt-fill"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="selected-pointer">
                            <ui:VisualElement class="icon-shadow"/>
                            <ui:VisualElement class="icon-outline"/>
                            <ui:VisualElement class="icon-art"/>
                        </ui:VisualElement>
