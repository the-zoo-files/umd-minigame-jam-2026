                    <ui:VisualElement class="card-data">
                        <ui:Label name="connectionDevice1"/>
                        <ui:Label name="connectionState1"/>
                        <ui:Button name="leavePlayer1"/>
                        <ui:Button name="addCpu1"/>
                        <ui:Button name="cpuDifficulty1"/>
                        <ui:VisualElement name="colorSelector1">
                            <ui:Button name="previousColor1"/>
                            <ui:Label name="playerColor1"/>
                            <ui:Button name="nextColor1"/>
                        </ui:VisualElement>
