:root {
    --hud-edge: 48px;
}

.hud-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.timer-container {
    position: absolute;
    top: var(--hud-edge);
    right: 0;
    left: 0;
    align-items: center;
}

.timer-panel {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    background-color: rgba(64, 58, 57, 0.94);
    border-radius: 38px;
}
.timer-icon {
    width: 44px;
    height: 44px;
    margin-right: 14px;
    background-image: url("project://database/Assets/UI/Lobby/TimerIcon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.round-timer {
    padding: 0;
    margin: 0;
    color: #ffffff;
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Fonts/FredokaOne-Lobby-SDF.asset");
    white-space: nowrap;
}
.player-hud {
    position: absolute;
    width: 334px;
    height: 128px;
    opacity: 0;
}
.player-hud.is-connected { opacity: 1; }
.portrait-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 128px;
    height: 128px;
    border-width: 3px;
    border-color: #ffffff;
    border-radius: 64px;
    background-color: #151313;
    overflow: hidden;
    flex-shrink: 0;
}
.player-portrait {
    flex-grow: 1;
    border-radius: 61px;
    background-image: url("project://database/Assets/UI/Lobby/TestudoPortrait.png");
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}
.player-summary {
    position: absolute;
    left: 104px;
    top: 18px;
}
.score-pill {
    flex-direction: row;
    align-items: center;
    width: 230px;
    height: 66px;
    padding: 5px 18px 5px 48px;
    border-radius: 33px;
    background-color: #403a39;
}
.potion-icon {
    width: 38px;
    height: 46px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Lobby/ScorePotion.png");
    -unity-background-scale-mode: scale-to-fit;
}
.player-score {
    margin: 0;
    padding: 0;
    flex-grow: 1;
    min-width: 0;
    color: #ffffff;
    font-size: 46px;
    -unity-font-definition: url("project://database/Assets/Fonts/FredokaOne-Lobby-SDF.asset");
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.player-name {
    margin: 0;
    padding: 2px 0 2px 30px;
    width: 200px;
    height: 32px;
    align-self: flex-start;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    background-image: url("project://database/Assets/UI/Lobby/HudNameFade.png");
    -unity-background-scale-mode: stretch-to-fill;
    color: #ffffff;
    font-size: 20px;
    -unity-font: url("project://database/Assets/Fonts/Fredoka-Regular.ttf");
    white-space: nowrap;
}

.player-one {
    top: var(--hud-edge);
    left: var(--hud-edge);
}

.player-two {
    top: var(--hud-edge);
    right: var(--hud-edge);
}

.player-three {
    right: var(--hud-edge);
    bottom: var(--hud-edge);
}

.player-four {
    bottom: var(--hud-edge);
    left: var(--hud-edge);
}
