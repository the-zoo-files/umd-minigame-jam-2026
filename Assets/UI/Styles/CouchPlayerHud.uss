:root {
    --hud-edge: 28px;
}

.hud-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.timer-container {
    position: absolute;
    top: var(--hud-edge);
    right: 0;
    left: 0;
    align-items: center;
}

.round-timer {
    padding: 10px 18px;
    background-color: rgba(10, 15, 25, 0.9);
    border-width: 2px;
    border-color: rgb(245, 248, 255);
    border-radius: 4px;
    color: rgb(245, 248, 255);
    font-size: 28px;
    -unity-font: url("project://database/Assets/UI/Fonts/CascadiaMono.ttf");
}

.player-name {
    position: absolute;
    padding: 10px 14px;
    background-color: rgba(10, 15, 25, 0.82);
    border-width: 2px;
    border-radius: 4px;
    color: rgb(245, 248, 255);
    font-size: 22px;
    -unity-font: url("project://database/Assets/UI/Fonts/CascadiaMono.ttf");
    white-space: normal;
    opacity: 0;
}

.player-name.is-connected {
    opacity: 1;
}

.player-one {
    top: var(--hud-edge);
    left: var(--hud-edge);
}

.player-two {
    top: var(--hud-edge);
    right: var(--hud-edge);
}

.player-three {
    right: var(--hud-edge);
    bottom: var(--hud-edge);
}

.player-four {
    bottom: var(--hud-edge);
    left: var(--hud-edge);
}
