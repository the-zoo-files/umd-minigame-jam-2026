.is-hidden,
.card-data,
.lobby-hidden-controls {
    display: none;
}

.connection-menu {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: #f4f1ee;
    background-image: url("project://database/Assets/Textures/UI/beakerBg.png");
    -unity-background-scale-mode: scale-and-crop;
    color: #2d2925;
    -unity-font: url("project://database/Assets/Fonts/Fredoka-Regular.ttf");
}

.lobby-header {
    height: 160px;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 32px;
    background-color: #eb5628;
}

.lobby-title-stack {
    position: relative;
    width: 100%;
    height: 80px;
}

.lobby-title {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: #f4f1ee;
    font-size: 64px;
    -unity-font-definition: url("project://database/Assets/Fonts/FredokaOne-Lobby-SDF.asset");
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.lobby-title-shadow {
    color: rgba(0, 0, 0, 0.25);
    -unity-text-outline-color: rgba(0, 0, 0, 0.25);
    -unity-text-outline-width: 12px;
    translate: 0 8px;
}

.lobby-title-stroke {
    color: #c94721;
    -unity-text-outline-color: #c94721;
    -unity-text-outline-width: 12px;
}

.lobby-title-fill {
    color: #f4f1ee;
}

.lobby-stage {
    flex-grow: 1;
    min-height: 0;
    align-items: center;
    justify-content: flex-end;
    padding-left: 155px;
    padding-right: 155px;
}

.connection-cards {
    width: 100%;
    height: 652px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.connection-card-frame {
    width: 360px;
    height: 640px;
    min-width: 250px;
    flex-shrink: 1;
    margin-left: 20px;
    margin-right: 20px;
    position: relative;
    overflow: visible;
}

.card-shadow {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.01);
}

.card-shadow-24 { top: -24px; right: -24px; bottom: -24px; left: -24px; border-radius: 48px; background-color: rgba(0, 0, 0, 0.008); }
.card-shadow-20 { top: -20px; right: -20px; bottom: -20px; left: -20px; border-radius: 44px; background-color: rgba(0, 0, 0, 0.009); }
.card-shadow-16 { top: -16px; right: -16px; bottom: -16px; left: -16px; border-radius: 40px; background-color: rgba(0, 0, 0, 0.011); }
.card-shadow-12 { top: -12px; right: -12px; bottom: -12px; left: -12px; border-radius: 36px; background-color: rgba(0, 0, 0, 0.014); }
.card-shadow-8 { top: -8px; right: -8px; bottom: -8px; left: -8px; border-radius: 32px; background-color: rgba(0, 0, 0, 0.018); }
.card-shadow-4 { top: -4px; right: -4px; bottom: -4px; left: -4px; border-radius: 28px; background-color: rgba(0, 0, 0, 0.025); }

.connection-card {
    --player-color: #eb5628;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 16px 16px 32px 16px;
    align-items: center;
    justify-content: space-between;
    overflow: visible;
    background-color: #e7e2da;
    border-radius: 24px;
}

.card-tilt-left { rotate: -2deg; }
.card-tilt-right { rotate: 2deg; }

.player-card-content {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    align-items: center;
}

.device-icon {
    position: relative;
    width: 96px;
    height: 98px;
    flex-shrink: 0;
}

.device-icon > .device-shadow,
.device-icon > .device-outline,
.device-icon > .device-fill,
.device-icon > .device-stroke {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.device-icon > .device-shadow,
.device-icon > .device-outline {
    top: -3px;
    right: -3px;
    bottom: -3px;
    left: -3px;
}

.device-icon > .device-shadow {
    translate: 0 4px;
    -unity-background-image-tint-color: rgba(45, 41, 37, 0.28);
}

.device-icon > .device-outline {
    -unity-background-image-tint-color: #f4f1ee;
}

.keyboard-device > .device-shadow,
.keyboard-device > .device-outline,
.keyboard-device > .device-fill { background-image: url("project://database/Assets/UI/Lobby/KeyboardLockFill.png"); }
.keyboard-device > .device-stroke { background-image: url("project://database/Assets/UI/Lobby/KeyboardLockStroke.png"); }
.controller-device > .device-shadow,
.controller-device > .device-outline,
.controller-device > .device-fill { background-image: url("project://database/Assets/UI/Lobby/ControllerFill.png"); }
.controller-device > .device-stroke { background-image: url("project://database/Assets/UI/Lobby/ControllerStroke.png"); }

.device-fill { -unity-background-image-tint-color: #a3a09a; }
.device-stroke { display: none; }
.keyboard-device { display: none; }
.connection-card.is-keyboard > .player-card-content > .keyboard-device { display: flex; }
.connection-card.is-keyboard > .player-card-content > .controller-device { display: none; }

.character-content {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    padding-top: 24px;
    align-items: center;
    overflow: hidden;
}

.character-portrait {
    width: 256px;
    height: 256px;
    flex-shrink: 0;
    border-width: 4px;
    border-color: var(--player-color);
    border-radius: 128px;
    background-color: var(--player-color);
    background-image: url("project://database/Assets/UI/Lobby/TestudoPortrait.png");
    -unity-background-scale-mode: scale-and-crop;
    overflow: visible;
}

.character-image {
    display: none;
}

.character-selector {
    width: 100%;
    height: 96px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.character-arrow {
    position: relative;
    width: 72px;
    height: 112px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.icon-shadow,
.icon-outline,
.icon-art {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-shadow,
.icon-outline {
    top: -3px;
    right: -3px;
    bottom: -3px;
    left: -3px;
}

.icon-shadow {
    translate: 0 4px;
    -unity-background-image-tint-color: rgba(45, 41, 37, 0.28);
}

.icon-outline { -unity-background-image-tint-color: #f4f1ee; }

.character-arrow > .icon-shadow,
.character-arrow > .icon-outline,
.character-arrow > .icon-art {
    background-image: url("project://database/Assets/Textures/UI/curvedArrow.png");
}

.character-arrow > .icon-shadow,
.character-arrow > .icon-outline {
    display: none;
}

.character-arrow > .icon-art { -unity-background-image-tint-color: #c7c0ad; }

.arrow-right { rotate: 180deg; }
.character-arrow:disabled { opacity: 0.25; }

.character-name-stack {
    flex-grow: 1;
    height: 96px;
    position: relative;
}

.character-name {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: var(--player-color);
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Fonts/FredokaOne-Lobby-SDF.asset");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

.character-name-shadow {
    color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-width: 6px;
    translate: 0 2px;
}

.character-name-stroke {
    color: #f4f1ee;
    -unity-text-outline-color: #f4f1ee;
    -unity-text-outline-width: 6px;
}

.card-action {
    position: relative;
    width: 100%;
    height: 64px;
    min-height: 64px;
    margin: 0;
    padding: 8px 32px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
    background-color: #f5f1ee;
    border-width: 0;
    border-radius: 32px;
    color: #eb5628;
}

.card-action:hover,
.card-action:focus {
    background-color: #f5f1ee;
}

.prompt-glyph-stack {
    position: relative;
    width: 48px;
    height: 48px;
    margin-right: 8px;
    flex-shrink: 0;
}

.card-prompt-content {
    width: 100%;
    height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    translate: 0 -8px;
}

.prompt-glyph {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0;
    overflow: visible;
    color: #eb5628;
    font-size: 84px;
    -unity-text-align: middle-center;
}

.prompt-glyph-shadow {
    color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-width: 6px;
    translate: 0 2px;
}

.prompt-glyph-stroke {
    color: #ffffff;
    -unity-text-outline-color: #ffffff;
    -unity-text-outline-width: 6px;
}

.input-keyboard > .prompt-glyph { -unity-font: url("project://database/Assets/Fonts/KenneyInput-KeyboardMouse.ttf"); }
.input-switch > .prompt-glyph { -unity-font: url("project://database/Assets/Fonts/KenneyInput-NintendoSwitch.ttf"); }
.input-xbox > .prompt-glyph { -unity-font: url("project://database/Assets/Fonts/KenneyInput-XboxSeries.ttf"); }

.card-prompt-text {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0;
    color: #eb5628;
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/Fonts/FredokaOne-Lobby-SDF.asset");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

.card-prompt-stack {
    position: relative;
    height: 48px;
    flex-shrink: 0;
    translate: 0 8px;
}

.card-prompt-sizer {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    height: 48px;
    opacity: 0;
}

.card-prompt-shadow {
    color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-width: 6px;
    translate: 0 2px;
}

.card-prompt-stroke {
    color: #ffffff;
    -unity-text-outline-color: #ffffff;
    -unity-text-outline-width: 6px;
}

.waiting-visual {
    display: none;
    width: 100%;
    flex-grow: 1;
    background-image: url("project://database/Assets/Textures/UI/waitingBg.png");
    -unity-background-scale-mode: scale-and-crop;
}

.connection-card.is-empty {
    background-color: #cbc8c1;
}

.connection-card.is-empty > .waiting-visual { display: flex; }
.connection-card.is-empty > .player-card-content { display: none; }
.connection-card.is-empty > .card-action > .card-prompt-content > .prompt-glyph-stack { display: none; }
.connection-card.is-empty > .card-action > .card-prompt-content > .card-prompt-stack > .card-prompt-fill {
    color: #4fafc1;
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/Fonts/Fredoka-Lobby-SDF.asset");
    -unity-text-outline-width: 0;
}

.connection-card.is-empty > .card-action > .card-prompt-content > .card-prompt-stack > .card-prompt-shadow,
.connection-card.is-empty > .card-action > .card-prompt-content > .card-prompt-stack > .card-prompt-stroke,
.connection-card.is-empty > .card-action > .card-prompt-content > .card-prompt-stack > .card-prompt-sizer {
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/Fonts/Fredoka-Lobby-SDF.asset");
}

.connection-card.is-unselected { opacity: 1; }

.connection-card.is-ready {
    background-color: var(--player-color);
}

.connection-card.is-ready .device-fill { -unity-background-image-tint-color: #ffffff; }
.connection-card.is-ready .device-stroke {
    display: flex;
    -unity-background-image-tint-color: var(--player-color);
}
.connection-card.is-ready .character-content { padding-top: 24px; }
.connection-card.is-ready .character-portrait { margin-bottom: -32px; }
.connection-card.is-ready .character-arrow { display: none; }
.connection-card.is-ready .character-selector { justify-content: center; }
.connection-card.is-ready .character-name {
    color: #ffffff;
    font-size: 64px;
}
.connection-card.is-ready .character-name-shadow {
    color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-width: 12px;
    translate: 0 4px;
}
.connection-card.is-ready .character-name-stroke {
    color: var(--player-color);
    -unity-text-outline-color: var(--player-color);
    -unity-text-outline-width: 12px;
}
.connection-card.is-ready > .card-action { background-color: #f5f1ee; }

.selected-pointer {
    display: none;
    position: absolute;
    width: 72px;
    height: 72px;
    right: -42px;
    bottom: -42px;
    rotate: 0deg;
}

.selected-pointer > .icon-shadow,
.selected-pointer > .icon-outline,
.selected-pointer > .icon-art {
    background-image: url("project://database/Assets/Textures/UI/selectedPointer.png");
}

.selected-pointer > .icon-shadow { -unity-background-image-tint-color: rgba(45, 41, 37, 0.28); }
.selected-pointer > .icon-outline { -unity-background-image-tint-color: #2d2925; }
.selected-pointer > .icon-art { -unity-background-image-tint-color: #f4f1ee; }

.card-action:focus > .selected-pointer { display: flex; }

.lobby-footer {
    height: 208px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding-top: 64px;
    padding-bottom: 64px;
}

.start-game {
    position: relative;
    width: 360px;
    height: 96px;
    margin: 0;
    padding: 16px 32px;
    overflow: visible;
    background-color: #eb5628;
    border-width: 0;
    border-radius: 48px;
    color: rgba(0, 0, 0, 0);
    font-size: 48px;
    -unity-font: url("project://database/Assets/Fonts/FredokaOne-Regular.ttf");
    -unity-text-align: middle-center;
}

.start-pointer {
    width: 102px;
    height: 102px;
    right: -53px;
    bottom: -51px;
}

.start-game:hover > .start-pointer,
.start-game:focus > .start-pointer {
    display: flex;
}

.start-text-stack {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.start-text {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: #f4f1ee;
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Fonts/FredokaOne-Lobby-SDF.asset");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

.start-text-shadow {
    color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-color: rgba(45, 41, 37, 0.28);
    -unity-text-outline-width: 6px;
    translate: 0 3px;
}

.start-text-stroke {
    color: #c94721;
    -unity-text-outline-color: #c94721;
    -unity-text-outline-width: 6px;
}

.connection-card.player-color-0 { --player-color: #eb5628; }
.connection-card.player-color-1 { --player-color: #4570bc; }
.connection-card.player-color-2 { --player-color: #117f2d; }
.connection-card.player-color-3 { --player-color: #ed54ba; }
.connection-card.player-color-4 { --player-color: #ef7d0e; }
.connection-card.player-color-5 { --player-color: #f5f557; }
.connection-card.player-color-6 { --player-color: #3f474e; }
.connection-card.player-color-7 { --player-color: #d6e0f0; }
.connection-card.player-color-8 { --player-color: #6b2fbb; }
.connection-card.player-color-9 { --player-color: #71491e; }
.connection-card.player-color-10 { --player-color: #38fedc; }
.connection-card.player-color-11 { --player-color: #50ef39; }
.connection-card.player-color-12 { --player-color: #6b2b3a; }
.connection-card.player-color-13 { --player-color: #ecc0d3; }
.connection-card.player-color-14 { --player-color: #fffebe; }
.connection-card.player-color-15 { --player-color: #708496; }
.connection-card.player-color-16 { --player-color: #928776; }
.connection-card.player-color-17 { --player-color: #ec7578; }
